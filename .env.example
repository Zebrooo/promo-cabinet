# Cabinet admin credentials + session signing
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

# S3-compatible storage (bucket.ru)
AWS_REGION=ru-1
PROMO_S3_ENDPOINT=https://s3.buckets.ru
PROMO_S3_FORCE_PATH_STYLE=true
PROMO_BUCKET=config
PROMO_KEY_PREFIX=
# AWS credentials via the standard SDK chain (env / shared config / role):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
