# Cabinet admin credentials + session signing
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

# S3-compatible storage (bucket.ru)
AWS_REGION=ru-1
PROMO_S3_ENDPOINT=https://s3.buckets.ru
PROMO_S3_FORCE_PATH_STYLE=true
PROMO_BUCKET=config
PROMO_KEY_PREFIX=
# AWS credentials via the standard SDK chain (env / shared config / role):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Web Push для админов (уведомления о новых рекламных кампаниях). Публичный
# VAPID-ключ — тот же, что WEB_PUSH_VAPID_PUBLIC_KEY у promo-bff; приватный
# живёт ТОЛЬКО у BFF. Пара генерируется один раз: `npx web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=
